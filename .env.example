# gofact — configuration. Copier en `.env` (jamais versionné) ou placer le
# fichier dans ~/.config/gofact/.env, puis renseigner ses propres valeurs.
# Toutes ces variables peuvent aussi être exportées directement par le shell.
# Chaque valeur est surchargeable facture par facture dans le sidecar JSON.

# --- Vendeur (émetteur des factures) -----------------------------------------
# Requis : sans GOFACT_SELLER_NAME, le JSON doit porter un bloc "seller".
GOFACT_SELLER_NAME="Studio Exemple"
GOFACT_SELLER_SIRET="12345678900014"       # ou GOFACT_SELLER_SIREN (9 chiffres)
GOFACT_SELLER_EMAIL="contact@exemple.test"
GOFACT_SELLER_ADDRESS="1 rue de l'Exemple"
GOFACT_SELLER_POSTAL_CODE="33000"
GOFACT_SELLER_CITY="Bordeaux"
GOFACT_SELLER_COUNTRY="FR"

# Assujetti à la TVA : renseigner le n° intracommunautaire (BT-31).
# En franchise en base (art. 293 B), laisser vide : gofact émet BT-32 = SIREN.
#GOFACT_SELLER_VAT_NUMBER="FR12345678901"

# Adresse électronique de routage Peppol (BT-34). Vide ⇒ SIREN + scheme 0225.
#GOFACT_SELLER_ELECTRONIC_ADDRESS="123456789"
#GOFACT_SELLER_ELECTRONIC_ADDRESS_SCHEME="0225"

# --- Règlement ----------------------------------------------------------------
# IBAN du compte de règlement (BT-84). Vide ⇒ omis de la facture.
GOFACT_PAYEE_IBAN="FR7630001007941234567890185"

# --- Régime de TVA par défaut -------------------------------------------------
# Utilisé quand la facture est exonérée et ne précise rien.
#GOFACT_VAT_EXEMPTION_MENTION="TVA non applicable, art. 293 B du CGI"
#GOFACT_VAT_EXEMPTION_CODE="VATEX-FR-FRANCHISE"

# --- Rendu --------------------------------------------------------------------
# Navigateur à utiliser. Vide ⇒ détection automatique (Chrome, Edge, Brave,
# Chromium) sur Linux, macOS et Windows.
#GOFACT_CHROME="/usr/bin/google-chrome"

# --- PDP SuperPDP (uniquement pour -send) -------------------------------------
# SECRETS : ne jamais committer ce fichier renseigné.
SUPERPDP_CLIENT_ID=""
SUPERPDP_CLIENT_SECRET=""
#SUPERPDP_BASE="https://api.superpdp.tech"
